        <% for (var chunk in htmlWebpackPlugin.files.js) { %>
        <script src="<%= htmlWebpackPlugin.files.js[chunk] %>"></script>
        <% } %>

        <script>
            function handleUpdate() {
                const file = document.getElementById('litemodule').files[0];
                const name = document.getElementById('litemodulename').value;
                Entry.loadLiteTestModule(file, name);
            }

            function changeWorkspaceMode(mode) {
                const option = {};

                if (mode === 'block') {
                    option.boardType = Entry.Workspace.MODE_BOARD;
                    option.textType = -1;
                } else {
                    option.boardType = Entry.Workspace.MODE_VIMBOARD;
                    option.textType = Entry.Vim.TEXT_TYPE_PY;
                    option.runType = Entry.Vim.WORKSPACE_MODE;
                }

                const workspace = Entry.getMainWS();

                if (workspace) {
                    workspace.setMode(option);
                } else {
                    console.error('entry workspace not found!');
                }
            }
        </script>
        <!--main script-->
        <script>
            window.PUBLIC_PATH_FOR_ENTRYJS = 'lib/entry-js/dist/';
            $(document).ready(function() {
                var initOption = {
                    libDir: '',
                    entryDir: '',
                    type: 'workspace',
                    textCodingEnable: true,
                };
                Entry.creationChangedEvent = new Entry.Event(window);
                Entry.init(document.getElementById('workspace'), initOption);
                Entry.loadProject();

                // [변경: 2026-08-24 17:38, 김병현 수정] 인공지능 모델 학습 팝업(entry-ml) 연동
                // 브라우저 indexedDB 에 학습 모델을 로컬 저장한다
                var dataApi = new Entryml.MlDataApi();
                Entry.aiLearning.setDataApi(dataApi);

                // 모델 학습하기 팝업 인스턴스
                var learningPopup = new Entryml.Popup({
                    container: document.getElementById('EntryLearningPopupContainer'),
                    isShow: false,
                    dataApi: dataApi,
                    data: {
                        tokenizerPath: 'https://playentry.org/lib/entry-ml/dist/resources',
                    },
                });

                learningPopup
                    .on('submit', function(aiLearningBlockItem) {
                        // 학습 완료 시 인공지능 블록 카테고리에 학습 모델 블록을 추가한다
                        Entry.dispatchEvent('popupAddBlocks', { category: 'ai_utilize' });
                        Entry.playground.setAiLearningBlock(aiLearningBlockItem);
                    })
                    .on('remove', function() {
                        Entry.aiLearning.removeLearningBlocks();
                    })
                    .on('close', function() {
                        Entry.aiLearning.reload();
                    });

                // 블록 메뉴 > 인공지능 > 모델 학습하기 버튼 클릭 시 발생하는 이벤트
                Entry.addEventListener('openAIUtilizeTrainManager', function() {
                    learningPopup.show({
                        tables: Entry.playground.dataTable.getTableJSON(),
                        model: Entry.aiLearning.getId(),
                        project: 'local-example',
                        availables: [
                            'image',
                            'speech',
                            'text',
                            'number',
                            'cluster',
                            'regression',
                            'logisticRegression',
                            'decisionTree',
                            'svm',
                        ],
                    });
                });

                // 실행 중 데이터 입력 팝업
                var learningPredict = new Entryml.Predict({
                    container: document.getElementById('EntryLearningPredictContainer'),
                    isShow: false,
                });
                var isPauseClicked = false;

                learningPredict
                    .on('show', function() {
                        isPauseClicked = false;
                        if (Entry.engine.state === 'run') {
                            Entry.engine.togglePause({ visible: false });
                        }
                    })
                    .on('pause', function() {
                        if (!isPauseClicked) {
                            isPauseClicked = true;
                            Entry.engine.togglePause({ visible: false });
                        }
                        Entry.engine.togglePause();
                    })
                    .on('stop', function() {
                        Entry.engine.toggleStop();
                    });

                Entry.addEventListener('openMLInputPopup', function(predictInfoItem) {
                    if (Entry.engine.state === 'run') {
                        Entry.engine.togglePause({ visible: false });
                    }
                    learningPredict.show({
                        title: '데이터 입력',
                        predictInfo: Object.assign({}, predictInfoItem),
                    });
                });

                // [변경: 2026-08-24 20:10, 김병현 수정] 데이터 테이블 "테이블 추가하기" 팝업 연동
                // DataTable 의 addTable 이 openTableManager 만 dispatch 하고
                // entryjs 안에는 리스너가 없어서 클릭해도 아무 반응이 없었다.
                var commonPopup = new EntryTool.Popup({
                    container: document.getElementById('popup-container'),
                    isShow: false,
                    theme: 'entry',
                    data: { data: { data: [] } },
                });

                commonPopup.on('submit', function(datas) {
                    // 테이블 불러오기에서 선택한 테이블을 데이터분석에 추가한다
                    (datas.selected || []).forEach(function(tableItem) {
                        Entry.playground.dataTable.addSources(tableItem);
                        Entry.creationChangedEvent.notify();
                    });
                });

                // [변경: 2026-08-24 20:35, 김병현 수정] "테이블 새로 만들기"(draw 이벤트) 처리
                // entry-tool 팝업은 UI 만 담당하고 데이터 생성은 호스트가 해야 한다.
                // playentry 는 서버 API 로 처리하지만 로컬 예제에서는 빈 테이블을 직접 만든다.
                commonPopup.on('draw', function() {
                    Entry.playground.dataTable.addSources([
                        {
                            name: Entry.getOrderedName(
                                '테이블',
                                Entry.playground.dataTable.tables,
                                'name'
                            ),
                            fields: ['A', 'B', 'C'],
                            data: [['', '', ''], ['', '', ''], ['', '', '']],
                        },
                    ]);
                    Entry.creationChangedEvent.notify();
                });

                Entry.addEventListener('openTableManager', function() {
                    commonPopup.show({ type: 'table' });
                });

                // [변경: 2026-08-24 17:38, 김병현 수정] 인공지능 블록 불러오기 버튼 임시 구현
                // TODO: 정식 선택 팝업이 아니라, 예제 확인용으로 tts/translate 블록을 즉시 추가하는 임시 코드다.
                Entry.addEventListener('openAIUtilizeBlockManager', function() {
                    Entry.playground.addAIUtilizeBlocks([{ name: 'tts' }, { name: 'translate' }]);
                });
            });
        </script>
    </body>
