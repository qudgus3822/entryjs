        <link rel="stylesheet" href="https://playentry.org/lib/entry-ml/dist/entry-ml.css" />
        <style>
            /* [변경: 2026-08-24 19:30, 김병현 수정] 인공지능 팝업 컨테이너 위치 기준 지정
               팝업 루트가 position:absolute 라서 기준이 되는 컨테이너가 없으면
               워크스페이스 아래쪽(화면 밖)에 높이 0으로 깔려 보이지 않는다. */
            #EntryLearningPopupContainer,
            #EntryLearningPredictContainer,
            #popup-container {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                z-index: 100;
                /* 팝업이 닫힌 상태에서 워크스페이스 클릭을 막지 않도록 한다 */
                pointer-events: none;
            }
            /* [변경: 2026-08-24 21:05, 김병현 수정] 테이블 팝업은 데이터분석 모달 위에 떠야 한다.
               데이터분석 모달(.table-modal)이 z-index:1000 이라
               기본값(100)으로 두면 "테이블 추가하기" 를 눌러도
               팝업이 모달 뒤에 가려져서 아무 반응이 없는 것처럼 보인다. */
            #popup-container {
                z-index: 1100;
            }
            #EntryLearningPopupContainer > *,
            #EntryLearningPredictContainer > *,
            #popup-container > * {
                pointer-events: auto;
            }
        </style>
    </head>

    <body>
