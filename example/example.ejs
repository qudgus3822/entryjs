        <!-- [변경: 2026-08-24 17:38, 김병현 수정] 인공지능 모델 학습 팝업(entry-ml) 및 의존 라이브러리 추가 -->
        <!-- [변경: 2026-08-24 19:30, 김병현 수정] tfjs 는 entryjs 와 entry-ml 이 각각 번들로 포함하므로
             CDN 사본을 추가하면 kernel 중복 등록 경고가 발생한다. 그래서 싣지 않는다. -->
        <script src="https://cdn.jsdelivr.net/npm/localforage@1.10.0/dist/localforage.min.js"></script>
